<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Snakes & Ladders</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#eef1f4;font-family:Arial,sans-serif}
body{min-height:100vh;display:flex;justify-content:center;align-items:center;padding:10px}
#game{width:min(1258px,100%);position:relative}
#stage{position:relative;width:100%;aspect-ratio:1258/868;overflow:hidden;background:#fff}
#bg{position:absolute;inset:0;width:100%;height:100%;display:block}
#boardLayer{position:absolute;left:7.31%;top:9.91%;width:77.58%;height:81.80%;z-index:5;pointer-events:none}
.token{position:absolute;transform:translate(-50%,-50%);width:clamp(22px,2.8vw,36px);height:clamp(22px,2.8vw,36px);border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:clamp(9px,1.2vw,14px);box-shadow:0 2px 7px rgba(0,0,0,.38);cursor:pointer;pointer-events:auto;transition:left .22s,top .22s,transform .15s;user-select:none}
.token:hover{transform:translate(-50%,-50%) scale(1.08)}
.token.selected{outline:3px solid #ffd400;outline-offset:2px;transform:translate(-50%,-50%) scale(1.12)}
#homeLayer{position:absolute;left:7.5%;bottom:1%;width:28%;height:7%;z-index:8}
.homeToken{position:absolute;width:clamp(20px,2.4vw,31px);height:clamp(20px,2.4vw,31px);border-radius:50%;border:2px solid white;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:clamp(8px,1vw,12px);box-shadow:0 2px 6px rgba(0,0,0,.3);cursor:pointer}
#controls{position:absolute;right:1.4%;bottom:1.4%;width:20.2%;z-index:10;display:flex;flex-direction:column;align-items:center;gap:7px}
#turn{background:rgba(255,255,255,.94);border-radius:10px;padding:6px 9px;font-size:clamp(10px,1.05vw,15px);font-weight:900;box-shadow:0 3px 10px rgba(0,0,0,.14);text-align:center}
#dice{width:56px;height:56px;border-radius:13px;background:#fff;display:flex;align-items:center;justify-content:center;font-size:31px;font-weight:900;box-shadow:0 5px 15px rgba(0,0,0,.18)}
#roll{border:0;border-radius:11px;background:#2563eb;color:white;padding:10px 13px;font-size:clamp(10px,1.05vw,15px);font-weight:900;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.18)}
#roll:disabled{background:#94a3b8;cursor:not-allowed}
#status{max-width:100%;background:rgba(255,255,255,.94);border-radius:9px;padding:6px 8px;font-size:clamp(8px,.9vw,12px);font-weight:700;text-align:center;box-shadow:0 3px 10px rgba(0,0,0,.12)}
#overlay{position:absolute;inset:0;background:rgba(0,0,0,.68);display:none;align-items:center;justify-content:center;z-index:30}
#modal{width:min(390px,80%);background:#fff;border-radius:22px;padding:28px;text-align:center;box-shadow:0 20px 70px rgba(0,0,0,.35)}
#modal .trophy{font-size:60px}
#modal h2{margin:6px 0;font-size:27px}
#modal p{margin:0;color:#64748b}
@media(max-width:720px){body{padding:4px}#controls{width:24%;right:.8%}#status{font-size:8px}#turn{font-size:9px}}
</style>
</head>
<body>
<div id="game">
<div id="stage">
<img id="bg" src="data:image/png;base64," alt="">
<div id="boardLayer"></div>
<div id="homeLayer"></div>
<div id="controls">
<div id="turn">Chọn quân cờ</div>
<div id="dice">–</div>
<button id="roll" disabled>🎲 TUNG XÚC XẮC</button>
<div id="status">Click bất kỳ quân nào để bắt đầu.</div>
</div>
<div id="overlay">
<div id="modal"><div class="trophy">🏆</div><h2 id="winner"></h2><p>Đã chạm chính xác ô 100!</p></div>
</div>
</div>
</div>

<script>
const ladders={9:33,16:46,22:58,44:83};
const snakes={37:3,68:14,91:53,96:57};
const colors=['#ef4444','#f97316','#eab308','#22c55e','#06b6d4','#3b82f6','#8b5cf6'];
const players=Array.from({length:7},(_,i)=>({id:i+1,pos:0,color:colors[i]}));

let selectedPlayerId=null;
let diceValue=null;
let waitingForTokenClick=false;
let moving=false;
let gameOver=false;

const boardLayer=document.getElementById('boardLayer');
const homeLayer=document.getElementById('homeLayer');
const turnEl=document.getElementById('turn');
const diceEl=document.getElementById('dice');
const rollBtn=document.getElementById('roll');
const statusEl=document.getElementById('status');
const overlay=document.getElementById('overlay');
const winnerEl=document.getElementById('winner');

function getPlayer(id) {
  return players.find(p=>p.id===id);
}

function cellXY(n) {
  const row=Math.floor((n-1)/10);
  let col=(n-1)%10;
  if(row%2===1) col=9-col;
  return {x:(col+0.5)*10,y:(9-row+0.5)*10};
}

function makeToken(p,isHome=false) {
  const el=document.createElement('div');
  el.className=isHome?'homeToken':'token';
  el.textContent=p.id;
  el.dataset.player=String(p.id);
  el.style.background=p.color;
  if(selectedPlayerId===p.id) el.classList.add('selected');
  el.addEventListener('click',(e)=>{
    e.stopPropagation();
    onTokenClick(p.id);
  });
  return el;
}

function render() {
  boardLayer.innerHTML='';
  homeLayer.innerHTML='';

  for(const p of players) {
    if(p.pos===0) {
      const t=makeToken(p,true);
      t.style.left=((p.id-1)*13.3+2)+'%';
      t.style.top='35%';
      homeLayer.appendChild(t);
    } else {
      const t=makeToken(p,false);
      const xy=cellXY(p.pos);
      t.style.left=xy.x+'%';
      t.style.top=xy.y+'%';
      boardLayer.appendChild(t);
    }
  }
}

function selectPlayer(id) {
  if(gameOver || moving) return;

  selectedPlayerId=id;
  diceValue=null;
  waitingForTokenClick=false;
  diceEl.textContent='–';
  rollBtn.disabled=false;

  const p=getPlayer(id);
  turnEl.textContent='Người chơi '+id+' đang chơi';
  turnEl.style.color=p.color;
  statusEl.textContent='Bấm TUNG XÚC XẮC cho Người chơi '+id+'.';
  render();
}

function onTokenClick(id) {
  if(gameOver || moving) return;

  if(selectedPlayerId===null) {
    selectPlayer(id);
    return;
  }

  if(waitingForTokenClick) {
    if(id===selectedPlayerId) {
      moveSelectedPlayer();
    } else {
      statusEl.textContent='Hãy click đúng quân '+selectedPlayerId+'.';
    }
    return;
  }

  if(id!==selectedPlayerId) {
    selectPlayer(id);
    return;
  }

  statusEl.textContent='Người chơi '+id+' đã chọn. Bấm TUNG XÚC XẮC.';
  rollBtn.disabled=false;
}

function rollDice() {
  if(gameOver || moving || selectedPlayerId===null || waitingForTokenClick) return;

  const p=getPlayer(selectedPlayerId);
  diceValue=Math.floor(Math.random()*6)+1;
  diceEl.textContent=String(diceValue);

  if(p.pos+diceValue>100) {
    rollBtn.disabled=true;
    waitingForTokenClick=false;
    statusEl.textContent='🎲 Ra '+diceValue+'. Vượt quá 100 → đứng yên.';
    setTimeout(()=>{
      diceValue=null;
      diceEl.textContent='–';
      rollBtn.disabled=false;
      statusEl.textContent='Người chơi '+p.id+' có thể TUNG XÚC XẮC tiếp.';
    },850);
    return;
  }

  waitingForTokenClick=true;
  rollBtn.disabled=true;
  statusEl.textContent='🎲 Ra '+diceValue+'. Click lại quân '+p.id+' để di chuyển.';
  render();
}

async function moveSelectedPlayer() {
  if(gameOver || moving || selectedPlayerId===null || !waitingForTokenClick || !diceValue) return;

  const p=getPlayer(selectedPlayerId);
  const steps=diceValue;
  waitingForTokenClick=false;
  moving=true;

  for(let i=0;i<steps;i++) {
    p.pos++;
    statusEl.textContent='Người chơi '+p.id+' đang đến ô '+p.pos+'.';
    render();
    await sleep(210);
  }

  if(p.pos===100) {
    moving=false;
    win(p);
    return;
  }

  if(ladders[p.pos]) {
    const from=p.pos,to=ladders[from];
    statusEl.textContent='🪜 Cầu thang: '+from+' → '+to;
    await sleep(600);
    p.pos=to;
    render();
    await sleep(450);
  } else if(snakes[p.pos]) {
    const from=p.pos,to=snakes[from];
    statusEl.textContent='🐍 Rắn: '+from+' → '+to;
    await sleep(600);
    p.pos=to;
    render();
    await sleep(450);
  }

  if(p.pos===100) {
    moving=false;
    win(p);
    return;
  }

  // Quan trọng: GIỮ NGUYÊN người chơi hiện tại.
  // Người chơi vừa đi có thể tung tiếp nhiều lần liên tục.
  diceValue=null;
  diceEl.textContent='–';
  rollBtn.disabled=false;
  moving=false;

  turnEl.textContent='Người chơi '+p.id+' đang chơi';
  turnEl.style.color=p.color;
  statusEl.textContent='Có thể TUNG XÚC XẮC tiếp, hoặc click quân khác để đổi người.';
  render();
}

function win(p) {
  gameOver=true;
  moving=false;
  rollBtn.disabled=true;
  winnerEl.textContent='🎉 Người chơi '+p.id+' chiến thắng!';
  overlay.style.display='flex';
  statusEl.textContent='Đã chạm chính xác ô 100!';
}

function sleep(ms) {
  return new Promise(resolve=>setTimeout(resolve,ms));
}

rollBtn.addEventListener('click',rollDice);
render();
</script>
</body>
</html>
